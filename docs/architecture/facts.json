      "tests、歷史 plans 與 archived OpenSpec changes"
    ]
  },
  "components": [
    {
      "id": "agent-hosts",
      "label": "Agent Hosts",
      "type": "external",
      "responsibility": "執行 Claude、Codex 與 Copilot session，產生待擷取內容並消費回灌記憶。",
      "sublabel": "agent runtimes",
      "basis": "declared",
      "evidence": [
        {
