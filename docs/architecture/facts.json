      "responsibility": "將 inbox session 確定性拆分、promotion、驗證並發布為原子 knowledge slices。",
      "sublabel": "split → promote → publish",
      "basis": "observed",
      "evidence": [
        {
          "path": "paulsha_hippo/atomizer/pipeline.py",
          "line": 1241,
          "end_line": 1258,
          "excerpt_sha256": "149898a3229df036bff2c06e499f900558a59fef755699c0df996bc5b39141b1",
