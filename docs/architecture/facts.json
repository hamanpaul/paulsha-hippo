    {
      "id": "runtime-ledgers",
      "label": "Runtime Ledgers",
      "type": "database",
      "responsibility": "以 append-only 記錄保存 import、processing、publication、dream 與 usage 生命週期證據。",
      "sublabel": "runtime/ledger/*.jsonl",
      "basis": "inferred",
      "reasoning": "Importer 與 Dream 各自在 runtime 流程中 append 不同 ledger；高階架構將這些同根、append-only 的權威記錄歸為一個資料元件。",
      "evidence": [
        {
          "path": "paulsha_hippo/dream/orchestrator.py",
