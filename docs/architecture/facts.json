        }
      ]
    },
    {
      "id": "dream-orchestrator",
      "label": "Dream Orchestrator",
      "type": "backend",
      "responsibility": "在單一 writer gate 下協調 atomize、janitor、followups 與 MOC/index 維護。",
      "sublabel": "scheduled consolidation",
      "basis": "observed",
      "evidence": [
        {
          "path": "paulsha_hippo/dream/cli.py",
